# ==============================================================================
# CycloneVision AI - Backend Configuration (.env)
# ==============================================================================
# MOSDAC Official Data Download API Credentials
# Register at: https://www.mosdac.gov.in
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=

# Dataset Identification:
# 3SIMG_L1B_STD : INSAT-3DS Imager Level-1B Standard (Operational, Half-hourly, 6 channels) - RECOMMENDED
# 3RIMG_L1B_STD : INSAT-3DR Imager Level-1B Standard (Operational backup)
# 3DIMG_L1B_STD : INSAT-3D Imager Level-1B Standard (Historical archive)
MOSDAC_DATASET_ID=3SIMG_L1B_STD

# INSAT Sensor Channel:
# IMG_TIR1 : Thermal Infrared 1 (10.8 µm - Primary Cyclone / Vortex Tracking Band)
# IMG_WV   : Water Vapor (6.7 µm - Upper Troposphere Dynamics)
# IMG_TIR2 : Thermal Infrared 2 (12.0 µm - Split Window)
# IMG_MIR  : Mid-Infrared (3.9 µm - High-temperature / Cirrus)
# IMG_VIS  : Visible (0.65 µm - Day-time High-resolution)
MOSDAC_CHANNEL=IMG_TIR1

# Polling Interval in Seconds (900 seconds = 15 minutes, matching half-hourly INSAT dissemination)
POLL_INTERVAL_SECONDS=900

# Storage configuration for raw satellite files, permanent prediction JSONs, and the latest image
# Set these to the actual mounted folders for your Google Drive / cloud-backed storage.
# Example: RAW_STORAGE_PATH=C:/Users/YourName/Google Drive/RawData
#          PREDICTIONS_STORAGE_PATH=C:/Users/YourName/Google Drive/Predictions
#          LATEST_IMAGE_PATH=C:/Users/YourName/Google Drive/Realtime/latest_satellite.png
RAW_STORAGE_PATH=./data/live/latest
PREDICTIONS_STORAGE_PATH=./live_outputs
LATEST_IMAGE_PATH=./data/live/preview/latest.png

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
